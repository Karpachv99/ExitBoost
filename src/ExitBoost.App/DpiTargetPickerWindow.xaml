    <Window x:Class="ExitBoost.App.DpiTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор целей обхода DPI" Width="640" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Window.Resources>
        <!-- Текст по умолчанию — светлый -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- Вкладки в тёмном стиле -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6,6,0,0"
                                Padding="12,7" Margin="0,0,4,0"
                                BorderBrush="Transparent" BorderThickness="1,1,1,0">
                            <ContentPresenter x:Name="cp" ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelAltBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Группа сервиса: тёмная раскрываемая строка -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="0,0,0,6">
                            <StackPanel>
                            <ToggleButton x:Name="toggle" Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="12,9" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="arrow" Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource MutedBrush}"
                                                      StrokeThickness="1.6" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="rot" Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Margin="9,0,0,0" ContentSource="Content" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="body" Visibility="Collapsed" ContentSource="Content" />
                        </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Элементы выпадающих списков: тёмные -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Padding="10,8" VerticalContentAlignment="Center" />
            <TextBlock x:Name="SearchHint" Text="Поиск сайта или программы: discord, youtube, steam…"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"
                       Foreground="{StaticResource MutedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem x:Name="PopularTab" Header="Популярные сайты">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Name}" IsExpanded="{Binding IsDefault}" Margin="0,2,0,2"
                                          ToolTip="{Binding Hint}">
                                    <WrapPanel Margin="14,6,10,10">
                                        <ItemsControl ItemsSource="{Binding Domains}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Domain}" IsChecked="{Binding Checked}"
                                                              MinWidth="210" Margin="0,3,10,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="BrowserTab" Header="Из браузера">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Запущенный браузер:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextBrush}" />
                        <ComboBox ItemsSource="{Binding RunningBrowsers}" SelectedItem="{Binding SelectedBrowser}"
                                  Width="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Прочитать историю" Margin="8,0,0,0" Command="{Binding LoadHistoryCommand}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BrowserDomains}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding Checked}"
                                              Margin="0,2,0,2" HorizontalAlignment="Left" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="ProcessTab" Header="Из программ">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Запущенная программа:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextBrush}" />
                        <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                                  Width="330" DisplayMemberPath="Display" />
                        <Button Content="Выбрать" Margin="8,0,0,0" Command="{Binding PickProcessCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding ProcessHint}" VerticalAlignment="Top" Margin="0,4,0,0" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Готово" Style="{StaticResource AccentButton}" Click="OnOk" Width="120" />
                <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" MinWidth="90" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
