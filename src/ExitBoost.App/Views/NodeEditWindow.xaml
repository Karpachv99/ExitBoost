<Window x:Class="ExitBoost.App.Views.NodeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Узел ретранслятора"
        Width="620" Height="660"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="Узел ретранслятора" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                       Text="Свои VPS, импортированный конфиг или публичный узел. Для WireGuard нужны приватный ключ, публичный ключ пира и локальный адрес." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource H2}" Text="Основное" Margin="0,0,0,8" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Имя" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="NameBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Страна" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="CountryBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Город" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="CityBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Адрес" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="HostBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Порт" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PortBox" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="Транспорт" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="3" x:Name="KindBox" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H2}" Text="WireGuard" Margin="0,0,0,8" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Приватный ключ" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PrivateKeyBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Публичный ключ пира" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PublicKeyBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Preshared key" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PresharedKeyBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Локальный адрес" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="AddressBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DNS" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="DnsBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MTU / Keepalive" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="MtuBox" Margin="0,0,8,0" />
                            <TextBox Grid.Column="2" x:Name="KeepaliveBox" Margin="0,0,8,0" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AllowedIPs" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="AllowedIpsBox" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H2}" Text="Прочее" Margin="0,0,0,8" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Файл конфига" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="ConfigPathBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Пользователь" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="UsernameBox" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Пароль" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="PasswordBox" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Заметки" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="NotesBox" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="OnSave" Margin="0,0,8,0" />
            <Button Content="Отмена" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
