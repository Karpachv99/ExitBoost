<Window x:Class="ExitBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExitBoost.App.Controls"
        xmlns:conv="clr-namespace:ExitBoost.App.Converters"
        Title="ExitBoost — игровой бустер"
        Height="740" Width="1200" MinHeight="620" MinWidth="1000"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:StringToBrushConverter x:Key="StringToBrush" />
        <conv:CountryToFlagConverter x:Key="CountryToFlag" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Выпадающий список с поиском прямо внутри выпадающего списка -->
        <Style x:Key="SearchableCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#10141A" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="5" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="content" Margin="8,6,26,6" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <TextBlock x:Name="placeholder" Margin="9,0,26,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Поиск: discord, youtube, steam…" />
                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Поиск: живёт прямо там, где список выбора -->
                                        <TextBox x:Name="PART_SearchBox" Grid.Row="0" Margin="6,6,6,4"
                                                 Padding="9,6" FontSize="12.5" VerticalContentAlignment="Center"
                                                 Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Введите часть названия программы или сайта" />

                                        <ScrollViewer Grid.Row="1" MaxHeight="280"
                                                      Focusable="True"
                                                      CanContentScroll="True"
                                                      PanningMode="VerticalOnly"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="toggle" Property="Background" Value="#141922" />
                            </Trigger>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Margin="1,1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,1,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==== Шапка ==== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ExitBoost" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="VPN по ключу, ускорение игр и обход DPI" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,5" Margin="0,0,14,0"
                            ToolTip="Работает ли обход DPI (zapret) прямо сейчас. Управление — на вкладке «Обход DPI».">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DpiActiveText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,5" Margin="0,0,14,0"
                            ToolTip="Ключ, через который идёт трафик (в названии ключа — его локация)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding StateColor, Converter={StaticResource StringToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding StateColor, Converter={StaticResource StringToBrush}}">
                                <Run Text="Ключ: " Foreground="{StaticResource MutedBrush}" />
                                <Run Text="{Binding HeaderKeyText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,5" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding StateColor, Converter={StaticResource StringToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding StateColor, Converter={StaticResource StringToBrush}}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Починить интернет" Command="{Binding RestoreNetworkCommand}" Margin="0,0,0,0"
                            ToolTip="Если подключение приложения сломало интернет — снимет туннель, вернёт маршруты, очистит DNS-кэш и проверит фактический доступ в сеть." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==== Основная область ==== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" MinWidth="360" MaxWidth="1100" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- ==== Панель серверов ==== -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ==== VPN-ключи — это и есть точки доступа (ретрансляторы) ==== -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H2}" Text="Локации" />
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VpnKeyCount}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Добавить ключ…" Command="{Binding VpnAddKeyCommand}" Margin="0,0,6,0"
                                    ToolTip="Вставьте ключ vless/vmess/trojan/ss/hysteria2 или ссылку на подписку" />
                            <Button Content="Удалить" Command="{Binding VpnRemoveKeyCommand}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding VpnKeysView}"
                              SelectedItem="{Binding SelectedVpnKey}"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              EnableRowVirtualization="True"
                              RowHeight="46"
                              MouseDoubleClick="VpnKeysGrid_MouseDoubleClick"
                              ToolTip="Двойной клик по локации или по названию страны — подключить VPN и включить обход DPI"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Локации" Width="*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,5,2,5"
                                              ToolTip="{Binding Server}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Flag}" FontSize="14" Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TitleText}" FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailsText}" FontSize="11" Margin="21,1,0,0"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                                                <TextBlock Text="{Binding PingText}" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{Binding QualityColor, Converter={StaticResource StringToBrush}}" />
                                                <TextBlock Text="{Binding Quality}" FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Expander IsExpanded="True" Foreground="{StaticResource TextBrush}"
                                                                  Background="Transparent" Padding="0,2,0,2">
                                                            <Expander.Header>
                                                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                                                        Padding="10,7" Margin="0,3,0,5">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="▣" FontSize="13" Margin="0,0,8,0"
                                                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding ItemCount, StringFormat='  ({0} ключей)'}"
                                                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Expander.Header>
                                                        <ItemsPresenter />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ==== Разделитель: ширина левой панели меняется мышью ==== -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          ToolTip="Потяните, чтобы сделать список локаций шире или уже" />

            <!-- ==== Правая панель ==== -->
            <TabControl Grid.Column="2" Margin="16,12,16,8">
                <TabItem Header="Подключение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,6,0">
                        <StackPanel>

                            <!-- Выбранная точка (VPN-ключ) -->
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Выбранная точка" />
                                    <TextBlock Margin="0,5,0,0">
                                        <Run Text="{Binding SelectedVpnKey.Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                        <Run Text=" · " /><Run Text="{Binding SelectedVpnKey.Country, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding SelectedVpnKey.Protocol, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding SelectedVpnKey.Server, Mode=OneWay}" />
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedVpnKey}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                                               Text="Локация не выбрана — нажмите на строку в списке слева (или дважды кликните, чтобы подключиться).">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedVpnKey}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="Точки выбираются в левой панели: там список ключей с пингом, потерями и качеством." />
                                </StackPanel>
                            </Border>

                            <!-- Опции -->
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Опции" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Text="При нажатии на крестик:" />
                                        <ComboBox Width="250"
                                                  SelectedIndex="{Binding CloseActionIndex}"
                                                  ToolTip="Что делать при закрытии окна: свернуть в значок трея или отключиться и выйти">
                                            <ComboBoxItem Content="Свернуть в трей (работа продолжится)" />
                                            <ComboBoxItem Content="Отключиться и выйти" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                               Text="При выходе программа сама отключит соединение, остановит обход DPI (вместе с драйвером) и снимет оставшиеся туннели, чтобы не оставить сеть в нерабочем состоянии." />

                                    <TextBlock Style="{StaticResource H2}" Text="Обновления" Margin="0,14,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="Обновления скачиваются только с официального репозитория GitLab и проверяются по SHA-256">
                                            <Run Text="Источник: " />
                                            <Run Text="{Binding UpdateSourceText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <Run Text=" (официальный)" />
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="Проверить обновления" Margin="8,0,0,0"
                                                Command="{Binding UpdateCheckCommand}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Content="Проверять при запуске" IsChecked="{Binding CheckAppUpdatesOnStart}" Margin="0,0,16,0" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding CurrentVersionText}" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="  ·  " />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="{Binding UpdateStatusText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,6,0,0" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Установить обновление" Style="{StaticResource AccentButton}"
                                                Command="{Binding UpdateInstallCommand}" Margin="0,0,6,4" />
                                        <Button Content="Отменить загрузку" Style="{StaticResource LinkButton}"
                                                Command="{Binding UpdateCancelCommand}" Margin="0,0,6,4"
                                                Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Страница релиза" Style="{StaticResource LinkButton}"
                                                Command="{Binding UpdateOpenPageCommand}" Margin="0,0,6,4" />
                                    </WrapPanel>
                                    <Border Background="#1AFFFFFF" CornerRadius="7" Padding="10" Margin="0,8,0,0"
                                            Visibility="{Binding HasUpdateNotes, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" FontWeight="SemiBold" Text="Что нового" />
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding UpdateNotesText}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding HasUpdateResult, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Text="{Binding UpdateResultText}" />
                                        <Button Content="Журнал обновления" Style="{StaticResource LinkButton}"
                                                Command="{Binding UpdateOpenLogCommand}" Margin="8,0,0,0"
                                                Visibility="{Binding HasUpdateLog, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- VPN по ключу -->
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource H2}" Text="VPN по ключу" VerticalAlignment="Center" />
                                        <Button Content="Обновить ядро" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                                Command="{Binding VpnInstallCoreCommand}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                               Text="Ключи выбираются в левой панели — там же видно пинг, потери и качество." />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
                                        <Run Text="Выбранный ключ: " />
                                        <Run Text="{Binding SelectedVpnKey.Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                        <Run Text=" (" /><Run Text="{Binding SelectedVpnKey.Country, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>

                                    <RadioButton GroupName="VpnMode" Margin="0,0,0,6"
                                                 IsChecked="{Binding VpnModeIsSplit, Mode=TwoWay}"
                                                 Content="Только выбранные сайты и программы (остальная сеть не трогается)" />
                                    <RadioButton GroupName="VpnMode" Margin="0,0,0,8"
                                                 IsChecked="{Binding VpnModeIsFull, Mode=TwoWay}"
                                                 Content="Весь трафик через VPN (нужно подтверждение)" />

                                    <TextBlock Style="{StaticResource H2}" Text="Сайты через VPN" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding VpnDomainsText}"
                                             ToolTip="Сайты, которые пойдут через VPN: youtube.com, discord.com, openai.com" />

                                    <Expander Margin="0,8,0,0" IsExpanded="True"
                                              HorizontalContentAlignment="Stretch"
                                              Foreground="{StaticResource TextBrush}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Добавленные сайты" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding VpnSelectedSitesCount, StringFormat=' ({0})'}"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6"
                                                Padding="6" Margin="0,4,0,0">
                                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding VpnSelectedSites}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,1,0,1">
                                                                <Button DockPanel.Dock="Right" Content="×" Width="24" Height="22"
                                                                        Command="{Binding DataContext.RemoveVpnSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Expander>

                                     <ComboBox Margin="0,6,0,0" MinHeight="38" FontSize="13"
                                            Style="{StaticResource SearchableCombo}"
                                              ItemsSource="{Binding VpnTargetsView}"
                                              SelectedItem="{Binding SelectedVpnTarget}"
                                              Tag="{Binding VpnTargetSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DropDownOpened="VpnTargetsCombo_DropDownOpened"
                                              DropDownClosed="VpnTargetsCombo_DropDownClosed"
                                               ToolTip="Поиск по запущенным приложениям. Выбранное приложение добавляется в список ниже">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}" Margin="9,7,9,3" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                     </ComboBox>
                                     <TextBlock Style="{StaticResource Muted}" Margin="0,7,0,2" Text="Выбранные приложения" />
                                     <ItemsControl ItemsSource="{Binding VpnSelectedPrograms}" Margin="0,3,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1,0,1">
                                                    <Button DockPanel.Dock="Right" Content="×" Width="24" Height="22"
                                                            Command="{Binding DataContext.RemoveVpnProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,4"
                                               Text="Готовый список заблокированных сервисов РФ" />
                                    <ComboBox SelectedIndex="{Binding BlockedPresetIndex, Mode=TwoWay}" MinHeight="34">
                                        <ComboBoxItem Content="Не использовать" />
                                        <ComboBoxItem Content="Стандартный список (≈1,2 тыс. доменов)" />
                                        <ComboBoxItem Content="Полный реестр РКН (≈1,7 млн доменов)" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding BlockedListStatus}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Muted}" Text="MTU туннеля:"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding VpnMtuText, UpdateSourceTrigger=LostFocus}"
                                                 Width="72" MinHeight="30"
                                                 ToolTip="1400 — для PPPoE, 1500 — для обычного Ethernet (допустимо 1280–9000)" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding VpnStatusColor, Converter={StaticResource StringToBrush}}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding VpnStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding VpnStatusColor, Converter={StaticResource StringToBrush}}" />
                                    </StackPanel>

                                     <WrapPanel Margin="0,10,0,0">
                                         <Button Content="Подключить VPN" Style="{StaticResource AccentButton}"
                                                 Command="{Binding VpnConnectCommand}" Margin="0,0,6,4" />
                                         <Button Content="Отключить VPN" Style="{StaticResource DangerButton}"
                                                 Command="{Binding VpnDisconnectCommand}" Margin="0,0,6,4" />
                                     </WrapPanel>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Тест скорости" Command="{Binding SpeedTestCommand}"
                                                ToolTip="Замер через текущее соединение: пинг, скачивание и отдача (Cloudflare)" />
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="{Binding SpeedTestText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Журнал">
                    <Grid Margin="0,12,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource H2}" Text="Журнал событий" VerticalAlignment="Center" />
                            <Button Content="Скопировать" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding CopyLogCommand}" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="#5A6478" />
                                        <Run Text=" " Foreground="#5A6478" />
                                        <Run Text="{Binding LevelText, Mode=OneWay}" Foreground="#7C87A0" />
                                        <Run Text="  " Foreground="#5A6478" />
                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="#DCE2EC" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
                <TabItem Header="Обход DPI">
                    <Grid Margin="0,12,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Движок -->
                        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <Border Background="#1A2FBF71" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DpiActiveText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Движок zapret" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiEngineStatus}" Margin="0,3,0,0" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiUpdateStatus}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="Обновить zapret" Command="{Binding DpiUpdateCommand}" Margin="0,0,6,0" />
                                        <Button Content="Проверить" Command="{Binding DpiCheckCommand}" Margin="0,0,6,0" />
                                        <Button Content="Стоп" Command="{Binding DpiStopCommand}" Margin="0,0,6,0" />
                                        <Button Content="Снять принудительно" Command="{Binding DpiForceStopCommand}"
                                                ToolTip="Убить все процессы zapret и выгрузить драйвер WinDivert — если трафик всё ещё перехватывается" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox Content="Проверять обновления при запуске" Margin="0,0,18,0" IsChecked="{Binding DpiCheckUpdates}" />
                                    <CheckBox Content="Обновлять автоматически" Margin="0,0,18,0" IsChecked="{Binding DpiAutoUpdate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Цели -->
                        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Что обходим" Margin="0,0,0,6" />
                                 <Grid>
                                     <TextBox Text="{Binding DpiTargetHosts, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Сайты для обхода DPI: discord.com, youtube.com" />
                                 </Grid>
                                 <ComboBox Margin="0,6,0,0" MinHeight="38" FontSize="13"
                                           Style="{StaticResource SearchableCombo}"
                                          ItemsSource="{Binding DpiTargetsView}"
                                          SelectedItem="{Binding SelectedDpiTarget}"
                                          Tag="{Binding DpiTargetSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="VpnTargetsCombo_DropDownOpened"
                                           DropDownClosed="DpiTargetsCombo_DropDownClosed"
                                           ToolTip="Поиск сайта или программы для обхода DPI" />
                                 <Expander Margin="0,8,0,0" IsExpanded="True"
                                           HorizontalContentAlignment="Stretch"
                                           Foreground="{StaticResource TextBrush}">
                                     <Expander.Header>
                                         <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="Добавленные сайты" FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextBrush}" />
                                             <TextBlock Text="{Binding DpiSelectedTargetsCount, StringFormat=' ({0})'}"
                                                        Foreground="{StaticResource MutedBrush}" />
                                         </StackPanel>
                                     </Expander.Header>
                                     <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6"
                                             Padding="6" Margin="0,4,0,0">
                                         <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                                       HorizontalScrollBarVisibility="Disabled">
                                             <ItemsControl ItemsSource="{Binding DpiSelectedTargets}">
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <DockPanel Margin="0,1,0,1">
                                                             <Button DockPanel.Dock="Right" Content="×" Width="24" Height="22"
                                                                     Command="{Binding DataContext.RemoveDpiTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     CommandParameter="{Binding}" />
                                                             <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                         </DockPanel>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </ScrollViewer>
                                     </Border>
                                 </Expander>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,4"
                                           Text="Готовый список заблокированных сервисов РФ" />
                                <ComboBox SelectedIndex="{Binding BlockedPresetIndex, Mode=TwoWay}" MinHeight="34">
                                    <ComboBoxItem Content="Не использовать" />
                                    <ComboBoxItem Content="Стандартный список (≈1,2 тыс. доменов)" />
                                    <ComboBoxItem Content="Полный реестр РКН (≈1,7 млн доменов)" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="{Binding BlockedPresetHint}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{Binding BlockedListStatus}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                           Text="Проверяется TLS-рукопожатие с этими доменами — именно его ломает DPI. Оценка: скорость ответа (отлично ≤ 100 мс, хорошо ≤ 200 мс и т.д.)." />
                            </StackPanel>
                        </Border>

                        <!-- Стратегии -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding DpiStrategies}" SelectedItem="{Binding SelectedDpiStrategy}"
                                  IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Стратегия" Binding="{Binding Name}" Width="*" MinWidth="180" />
                                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="150" />
                                <DataGridTextColumn Header="Оценка" Binding="{Binding ScoreText}" Width="110" />
                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Действия -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="Автоподбор лучшей" Style="{StaticResource AccentButton}" Command="{Binding DpiAutoSelectCommand}" Margin="0,0,8,0" />
                                <Button Content="Применить" Command="{Binding DpiApplyCommand}" Margin="0,0,8,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiProgressText}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                    <Run Text="Без обхода: " Foreground="#5A6478" />
                                    <Run Text="{Binding DpiBaselineText, Mode=OneWay}" />
                                    <Run Text="   Лучшая: " Foreground="#5A6478" />
                                    <Run Text="{Binding DpiBestText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ==== Статус-бар ==== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Run Text="Интерфейс: " />
                    <Run Text="{Binding InterfaceText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center">
                    <Run Text="Время: " />
                    <Run Text="{Binding ElapsedText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>

