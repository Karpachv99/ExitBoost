<Window x:Class="ExitBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExitBoost.App.Controls"
        xmlns:conv="clr-namespace:ExitBoost.App.Converters"
        Title="ExitBoost — игровой бустер"
        Height="740" Width="1200" MinHeight="620" MinWidth="1000"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:StringToBrushConverter x:Key="StringToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==== Шапка ==== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ExitBoost" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="VPN по ключу, ускорение игр и обход DPI" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,5" Margin="0,0,14,0"
                            ToolTip="Работает ли обход DPI (zapret) прямо сейчас. Управление — на вкладке «Обход DPI».">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DpiActiveText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,5" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding StateColor, Converter={StaticResource StringToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding StateColor, Converter={StaticResource StringToBrush}}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Подключить" Style="{StaticResource AccentButton}" Command="{Binding ConnectCommand}" />
                    <Button Content="Отключить" Style="{StaticResource DangerButton}" Command="{Binding DisconnectCommand}" Margin="8,0,0,0" />
                    <Button Content="Починить интернет" Command="{Binding RestoreNetworkCommand}" Margin="12,0,0,0"
                            ToolTip="Если подключение приложения сломало интернет — снимет туннель, вернёт маршруты, очистит DNS-кэш и проверит фактический доступ в сеть." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==== Основная область ==== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" MinWidth="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== Панель серверов ==== -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ==== VPN-ключи — это и есть точки доступа (ретрансляторы) ==== -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H2}" Text="VPN-ключи" />
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VpnKeyCount}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Добавить ключ…" Command="{Binding VpnAddKeyCommand}" Margin="0,0,6,0"
                                    ToolTip="Вставьте ключ vless/vmess/trojan/ss/hysteria2 или ссылку на подписку" />
                            <Button Content="Удалить" Command="{Binding VpnRemoveKeyCommand}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding VpnKeyRows}"
                              SelectedItem="{Binding SelectedVpnKey}"
                              IsReadOnly="True"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Узел" Binding="{Binding Name}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="88" />
                            <DataGridTextColumn Header="Пинг" Binding="{Binding Ping}" Width="58" />
                            <DataGridTextColumn Header="Потери" Binding="{Binding Loss}" Width="62" />
                            <DataGridTextColumn Header="Джиттер" Binding="{Binding Jitter}" Width="66" />
                            <DataGridTextColumn Header="Качество" Binding="{Binding Quality}" Width="84" />
                            <DataGridTextColumn Header="Протокол" Binding="{Binding Protocol}" Width="88" />
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Server}" Width="150" />
                            <DataGridTextColumn Header="Защита" Binding="{Binding Security}" Width="66" />
                            <DataGridTextColumn Header="Транспорт" Binding="{Binding Transport}" Width="76" />
                            <DataGridTextColumn Header="Поток" Binding="{Binding Flow}" Width="120" />
                            <DataGridTextColumn Header="SNI" Binding="{Binding Sni}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Добавлен" Binding="{Binding AddedAt}" Width="74" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ==== Правая панель ==== -->
            <TabControl Grid.Column="1" Margin="16,12,16,8">
                <TabItem Header="Подключение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,6,0">
                        <StackPanel>

                            <!-- Выбранная точка (VPN-ключ) -->
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Выбранная точка" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0">
                                        <Run Text="{Binding SelectedVpnKey.Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                        <Run Text=" · " /><Run Text="{Binding SelectedVpnKey.Country, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding SelectedVpnKey.Protocol, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding SelectedVpnKey.Server, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="Точки выбираются в левой панели: там список ключей с пингом, потерями и качеством." />
                                </StackPanel>
                            </Border>

                            <!-- Опции -->
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Опции" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Text="При нажатии на крестик:" />
                                        <ComboBox Width="250"
                                                  SelectedIndex="{Binding CloseActionIndex}"
                                                  ToolTip="Что делать при закрытии окна: свернуть в значок трея или отключиться и выйти">
                                            <ComboBoxItem Content="Свернуть в трей (работа продолжится)" />
                                            <ComboBoxItem Content="Отключиться и выйти" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                               Text="При выходе программа сама отключит соединение, остановит обход DPI (вместе с драйвером) и снимет оставшиеся туннели, чтобы не оставить сеть в нерабочем состоянии." />

                                    <TextBlock Style="{StaticResource H2}" Text="Обновления" Margin="0,14,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding UpdateRepo, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Репозиторий GitHub с релизами: «владелец/имя», например ivanov/ExitBoost" />
                                        <Button Grid.Column="1" Content="Проверить обновления" Margin="8,0,0,0"
                                                Command="{Binding UpdateCheckCommand}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Content="Проверять при запуске" IsChecked="{Binding CheckAppUpdatesOnStart}" Margin="0,0,16,0" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding CurrentVersionText}" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="  ·  " />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="{Binding UpdateStatusText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,6,0,0" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Установить обновление" Style="{StaticResource AccentButton}"
                                                Command="{Binding UpdateInstallCommand}" Margin="0,0,6,4" />
                                        <Button Content="Страница релиза" Style="{StaticResource LinkButton}"
                                                Command="{Binding UpdateOpenPageCommand}" Margin="0,0,6,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- VPN по ключу -->
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource H2}" Text="VPN по ключу" VerticalAlignment="Center" />
                                        <Button Content="Обновить ядро" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                                Command="{Binding VpnInstallCoreCommand}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                               Text="Ключи выбираются в левой панели — там же видно пинг, потери и качество." />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
                                        <Run Text="Выбранный ключ: " />
                                        <Run Text="{Binding SelectedVpnKey.Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                        <Run Text=" (" /><Run Text="{Binding SelectedVpnKey.Country, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>

                                    <RadioButton GroupName="VpnMode" Margin="0,0,0,6"
                                                 IsChecked="{Binding VpnModeIsSplit, Mode=TwoWay}"
                                                 Content="Только выбранные сайты и программы (остальная сеть не трогается)" />
                                    <RadioButton GroupName="VpnMode" Margin="0,0,0,8"
                                                 IsChecked="{Binding VpnModeIsFull, Mode=TwoWay}"
                                                 Content="Весь трафик через VPN (нужно подтверждение)" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource H2}" Text="Сайты через VPN" />
                                            <TextBlock Style="{StaticResource Muted}" Text="Выбираются тем же окном, что и цели обхода DPI" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Выбрать сайты…" Command="{Binding VpnPickTargetsCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBox Text="{Binding VpnDomainsText}"
                                             ToolTip="Сайты, которые пойдут через VPN: youtube.com, discord.com, openai.com" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource H2}" Text="Программы через VPN" />
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding VpnProgramsSummary}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Обновить список" Style="{StaticResource LinkButton}"
                                                Command="{Binding RefreshProcessesCommand}" VerticalAlignment="Top" />
                                    </Grid>
                                    <ComboBox Margin="0,6,0,0"
                                              ItemsSource="{Binding VpnProgramsView}"
                                              SelectedItem="{Binding SelectedVpnProgram}"
                                              DisplayMemberPath="DisplayName"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              Text="{Binding VpnProgramSearch, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Введите часть названия, чтобы отфильтровать список, и выберите программу — она добавится в список VPN" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                               Text="Можно дописать имя процесса вручную (через запятую): discord.exe, steam.exe" />
                                    <TextBox Text="{Binding VpnProcsText}" Margin="0,4,0,0"
                                             ToolTip="Фильтр по процессу работает на TUN-адаптере sing-box" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding VpnStatusColor, Converter={StaticResource StringToBrush}}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding VpnStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding VpnStatusColor, Converter={StaticResource StringToBrush}}" />
                                    </StackPanel>

                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Подключить VPN" Style="{StaticResource AccentButton}"
                                                Command="{Binding VpnConnectCommand}" Margin="0,0,6,4" />
                                        <Button Content="Отключить VPN" Style="{StaticResource DangerButton}"
                                                Command="{Binding VpnDisconnectCommand}" Margin="0,0,6,4" />
                                    </WrapPanel>

                                    <CheckBox Content="Кнопка «Подключить» поднимает ещё и VPN по ключу" Margin="0,6,0,0"
                                              IsChecked="{Binding VpnConnectWithRelay}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Журнал">
                    <Grid Margin="0,12,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource H2}" Text="Журнал событий" VerticalAlignment="Center" />
                            <Button Content="Скопировать" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding CopyLogCommand}" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="#5A6478" />
                                        <Run Text=" " Foreground="#5A6478" />
                                        <Run Text="{Binding LevelText, Mode=OneWay}" Foreground="#7C87A0" />
                                        <Run Text="  " Foreground="#5A6478" />
                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="#DCE2EC" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
                <TabItem Header="Обход DPI">
                    <Grid Margin="0,12,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Движок -->
                        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <Border Background="#1A2FBF71" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DpiActiveText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Движок zapret" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiEngineStatus}" Margin="0,3,0,0" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiUpdateStatus}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="Обновить zapret" Command="{Binding DpiUpdateCommand}" Margin="0,0,6,0" />
                                        <Button Content="Проверить" Command="{Binding DpiCheckCommand}" Margin="0,0,6,0" />
                                        <Button Content="Стоп" Command="{Binding DpiStopCommand}" Margin="0,0,6,0" />
                                        <Button Content="Снять принудительно" Command="{Binding DpiForceStopCommand}"
                                                ToolTip="Убить все процессы zapret и выгрузить драйвер WinDivert — если трафик всё ещё перехватывается" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox Content="Проверять обновления при запуске" Margin="0,0,18,0" IsChecked="{Binding DpiCheckUpdates}" />
                                    <CheckBox Content="Обновлять автоматически" Margin="0,0,18,0" IsChecked="{Binding DpiAutoUpdate}" />
                                    <CheckBox Content="Применять при подключении к узлу" IsChecked="{Binding DpiApplyOnConnect}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Цели -->
                        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Что обходим" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding DpiTargetHosts, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Домены через запятую, например: discord.com, cdn.discordapp.com" />
                                    <Button Grid.Column="1" Content="Выбрать…" Margin="8,0,0,0"
                                            Command="{Binding DpiPickTargetsCommand}"
                                            ToolTip="Выбрать домены из списка популярных сайтов, истории браузера или запущенных программ" />
                                    <TextBox Grid.Column="2" Text="{Binding DpiTargetPort, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                           Text="Проверяется TLS-рукопожатие с этими доменами — именно его ломает DPI. Оценка: скорость ответа (отлично ≤ 100 мс, хорошо ≤ 200 мс и т.д.)." />
                            </StackPanel>
                        </Border>

                        <!-- Стратегии -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding DpiStrategies}" SelectedItem="{Binding SelectedDpiStrategy}"
                                  IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Стратегия" Binding="{Binding Name}" Width="*" MinWidth="180" />
                                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="150" />
                                <DataGridTextColumn Header="Оценка" Binding="{Binding ScoreText}" Width="110" />
                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Действия -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="Автоподбор лучшей" Style="{StaticResource AccentButton}" Command="{Binding DpiAutoSelectCommand}" Margin="0,0,8,0" />
                                <Button Content="Применить" Command="{Binding DpiApplyCommand}" Margin="0,0,8,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiProgressText}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                    <Run Text="Без обхода: " Foreground="#5A6478" />
                                    <Run Text="{Binding DpiBaselineText, Mode=OneWay}" />
                                    <Run Text="   Лучшая: " Foreground="#5A6478" />
                                    <Run Text="{Binding DpiBestText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ==== Статус-бар ==== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Run Text="Интерфейс: " />
                    <Run Text="{Binding InterfaceText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center">
                    <Run Text="Время: " />
                    <Run Text="{Binding ElapsedText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>

