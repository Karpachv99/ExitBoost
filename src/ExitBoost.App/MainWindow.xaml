<Window x:Class="ExitBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ExitBoost.App.Converters"
        Title="ExitBoost — игровой бустер"
        Height="820" Width="1280" MinHeight="680" MinWidth="1100"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:StringToBrushConverter x:Key="StringToBrush" />
        <conv:CountryToFlagConverter x:Key="CountryToFlag" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Выпадающий список с поиском прямо внутри выпадающего списка -->
        <Style x:Key="SearchableCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#10141A" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="5" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="content" Margin="8,6,26,6" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <TextBlock x:Name="placeholder" Margin="9,0,26,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Поиск: discord, youtube, steam…" />
                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBox x:Name="PART_SearchBox" Grid.Row="0" Margin="6,6,6,4"
                                                 Padding="9,6" FontSize="12.5" VerticalContentAlignment="Center"
                                                 Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Введите часть названия программы или сайта" />

                                        <ScrollViewer Grid.Row="1" MaxHeight="280"
                                                      Focusable="True"
                                                      CanContentScroll="True"
                                                      PanningMode="VerticalOnly"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="toggle" Property="Background" Value="#141922" />
                            </Trigger>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Margin="1,1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,1,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Боковое меню ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0" />
                                <GradientStop Color="#2C5FD1" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE945;" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ExitBoost" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="GAME BOOSTER" FontSize="8.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="Nav" Grid.Row="1" Margin="0,22,0,0"
                         SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="15"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Главная" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE707;" FontSize="15"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Локации" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="15"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Обход DPI" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="15"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Журнал" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Настройки" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="3">
                    <Border Style="{StaticResource Pill}" Padding="10,7" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                            <TextBlock Text="{Binding DpiActiveText}" FontSize="10.5" TextWrapping="Wrap"
                                       MaxWidth="160" />
                        </StackPanel>
                    </Border>
                    <Button Content="Починить интернет" Command="{Binding RestoreNetworkCommand}"
                            HorizontalAlignment="Stretch"
                            ToolTip="Снять туннель, вернуть маршруты, очистить DNS-кэш и проверить доступ в сеть" />
                    <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Правая часть ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: выбор локации и статусы -->
            <Border Grid.Row="0" Background="#0B0F17"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#13203A"
                            BorderBrush="#1E3A66" BorderThickness="1" VerticalAlignment="Center"
                            ToolTip="Текущая локация">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE707;" FontSize="17"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,12,0"
                                VerticalAlignment="Center">
                        <Grid Width="390" Height="48" VerticalAlignment="Center">
                            <ComboBox x:Name="LocationSelector"
                                      Style="{StaticResource LocationCombo}"
                                      ItemsSource="{Binding VpnPickView}"
                                      SelectedItem="{Binding SelectedVpnKey}"
                                      ToolTip="Страна и ключ, через которые пойдёт трафик. Список — все добавленные в VPN локации.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Flag}" FontSize="17" Margin="0,0,9,0"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Country}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding PingText}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{Binding QualityColor, Converter={StaticResource StringToBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Локация не выбрана" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Margin" Value="15,0,0,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedVpnKey}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   MaxWidth="230" TextTrimming="CharacterEllipsis"
                                   Text="Выберите страну здесь или на главной" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0"
                                ToolTip="Работает ли обход DPI (zapret) прямо сейчас">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                                <TextBlock Text="{Binding DpiActiveText}" FontSize="11.5" FontWeight="SemiBold"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" ToolTip="Состояние подключения">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding StateColor, Converter={StaticResource StringToBrush}}" />
                                <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding StateColor, Converter={StaticResource StringToBrush}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Страницы -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ==================== 0. Главная ==================== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,18,24,20">
                        <StackPanel>

                            <!-- Герой-блок: кнопка питания, таймер и статистика -->
                            <Border CornerRadius="16" ClipToBounds="True" Margin="0,0,0,18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0A1220" Offset="0" />
                                        <GradientStop Color="#0D1728" Offset="0.55" />
                                        <GradientStop Color="#111C31" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid MinHeight="344">
                                    <Ellipse Width="470" Height="470" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#3A3E7BFA" Offset="0" />
                                                <GradientStop Color="#003E7BFA" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="360" Height="360" HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom" Margin="0,0,-80,-140"
                                             IsHitTestVisible="False" Opacity="0.35">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#2A4C8DFF" Offset="0" />
                                                <GradientStop Color="#004C8DFF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <Grid Margin="30,20,30,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="280" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Кнопка питания и состояние -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedVpnKey}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding SelectedVpnKey.Flag}" FontSize="18"
                                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedVpnKey.Country}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedVpnKey.Name}" FontSize="12"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="280" />
                                                </StackPanel>
                                                <TextBlock Text="Локация не выбрана" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedVpnKey}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Width="200" Height="200" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <Ellipse Width="200" Height="200" Stroke="#1E3A66" StrokeThickness="1"
                                                         Opacity="0.65" />
                                                <!-- Одна кнопка: пока VPN работает — отключает, иначе подключает -->
                                                <Button Command="{Binding VpnConnectCommand}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        ToolTip="Подключить или отключить VPN">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PowerButton}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVpnRunning}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <StackPanel Visibility="{Binding IsVpnRunning, Converter={StaticResource InverseBoolToVis}}">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE945;"
                                                                       FontSize="46" Foreground="White" HorizontalAlignment="Center" />
                                                            <TextBlock Text="ПОДКЛЮЧИТЬ" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="#9FB6DA" HorizontalAlignment="Center"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Visibility="{Binding IsVpnRunning, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;"
                                                                       FontSize="42" Foreground="White" HorizontalAlignment="Center" />
                                                            <TextBlock Text="ОТКЛЮЧИТЬ" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="#9FB6DA" HorizontalAlignment="Center"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </Grid>

                                            <TextBlock Text="{Binding StateTextUpper}" FontSize="23" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,14,0,0"
                                                       Foreground="{Binding StateColor, Converter={StaticResource StringToBrush}}" />
                                            <TextBlock Text="{Binding ElapsedText}" FontSize="14"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                                       Foreground="#7C87A0" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                                       MaxWidth="430" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>

                                        <!-- Статистика -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="СТАТИСТИКА" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#5F6E88"
                                                       Margin="2,0,0,8" />

                                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="9" Background="#16233D"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE916;"
                                                                   FontSize="16" Foreground="#6E9BE8"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Пинг" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Text="{Binding SelectedVpnKey.PingText, TargetNullValue=—}"
                                                                   FontSize="17" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="9" Background="#16233D"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;"
                                                                   FontSize="16" Foreground="#6E9BE8"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Загрузка" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Text="{Binding StatDownloadText}"
                                                                   FontSize="17" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="9" Background="#16233D"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;"
                                                                   FontSize="16" Foreground="#6E9BE8"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Отдача" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Text="{Binding StatUploadText}"
                                                                   FontSize="17" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource StatCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="9" Background="#16233D"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;"
                                                                   FontSize="16" Foreground="#6E9BE8"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Протокол" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Text="{Binding SelectedVpnKey.Protocol, TargetNullValue=—}"
                                                                   FontSize="17" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Страны, добавленные в VPN -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Страны" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="9" Padding="8,2"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VpnCountryCount}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="Клик по стране выбирает лучшую локацию — подключение одной кнопкой" />
                                    </StackPanel>
                                    <Button Content="Все локации →" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding NavigateCommand}" CommandParameter="1" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" MaxHeight="222" Margin="0,8,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding CountryTiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CountryTile}"
                                                            Command="{Binding DataContext.SelectCountryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Выбрать эту страну">
                                                        <StackPanel>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Flag}" FontSize="22"
                                                                           HorizontalAlignment="Left" />
                                                                <TextBlock Text="{Binding PingText}" FontSize="10.5"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                           Foreground="{Binding PingColor, Converter={StaticResource StringToBrush}}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Country}" FontSize="12"
                                                                       FontWeight="SemiBold" Margin="0,7,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CountText}" FontSize="10"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Пока нет ни одной страны. Добавьте ключ или подписку в разделе «Локации» — плитки появятся здесь."
                                                   MaxWidth="460" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VpnCountryCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- Быстрые действия и обход DPI -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Text="Быстрые действия" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <Button Content="Выбрать локацию" Style="{StaticResource AccentButton}"
                                                    Command="{Binding NavigateCommand}" CommandParameter="1"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Тест скорости" Command="{Binding SpeedTestCommand}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Починить интернет" Command="{Binding RestoreNetworkCommand}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Обновить списки" Command="{Binding RefreshListsCommand}"
                                                    Margin="0,0,8,8"
                                                    ToolTip="Скачать свежую копию списков РКН, не дожидаясь недели" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                   Text="{Binding SpeedTestText}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Обход DPI" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                                            <TextBlock Text="{Binding DpiActiveText}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                                   Text="{Binding DpiEngineStatus, StringFormat='Движок: {0}'}" />
                                        <Button Content="Настроить обход DPI" Style="{StaticResource AccentButton}"
                                                Command="{Binding NavigateCommand}" CommandParameter="2"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== 1. Локации ==================== -->
                <TabItem>
                    <Grid Margin="24,18,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Локации" />
                                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="9" Padding="8,2"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VpnKeyCount}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Text="Двойной клик по строке — подключиться" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Добавить ключ…" Command="{Binding VpnAddKeyCommand}" Margin="0,0,8,0"
                                        ToolTip="Вставьте ключ vless/vmess/trojan/ss/hysteria2 или ссылку на подписку" />
                                <Button Content="Удалить" Command="{Binding VpnRemoveKeyCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" MinWidth="420" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                                <DataGrid ItemsSource="{Binding VpnKeysView}"
                                          SelectedItem="{Binding SelectedVpnKey}"
                                          IsReadOnly="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          EnableRowVirtualization="True"
                                          RowHeight="46"
                                          MouseDoubleClick="VpnKeysGrid_MouseDoubleClick"
                                          ToolTip="Двойной клик по локации или по названию страны — подключить VPN и включить обход DPI"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Ключ → страна → локация" Width="*" MinWidth="240">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,5,2,5" ToolTip="{Binding Server}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Flag}" FontSize="14" Margin="0,0,7,0"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding TitleText}" FontSize="13" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DetailsText}" FontSize="11" Margin="21,1,0,0"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                                                            <TextBlock Text="{Binding PingText}" FontSize="12" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{Binding QualityColor, Converter={StaticResource StringToBrush}}" />
                                                            <TextBlock Text="{Binding Quality}" FontSize="10"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="{x:Type GroupItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                <Expander IsExpanded="True" Foreground="{StaticResource TextBrush}"
                                                                          Background="Transparent" Padding="0,2,0,2">
                                                                    <Expander.Header>
                                                                        <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                                                                Padding="10,7" Margin="0,3,0,5">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="▣" FontSize="13" Margin="0,0,8,0"
                                                                                           Foreground="{StaticResource AccentBrush}"
                                                                                           VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource TextBrush}"
                                                                                           VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding ItemCount, StringFormat='  ({0})'}"
                                                                                           Foreground="{StaticResource MutedBrush}"
                                                                                           VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter />
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                </DataGrid>
                            </Border>

                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Выбранная локация" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="Локация не выбрана. Выберите страну в шапке окна или ключ в списке слева.">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedVpnKey}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedVpnKey}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SelectedVpnKey.Flag}" FontSize="24"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedVpnKey.Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                                        <TextBlock Text="{Binding SelectedVpnKey.Server}"
                                                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedVpnKey.Country}" />
                                                    <TextBlock Style="{StaticResource Muted}" Text=" · " />
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedVpnKey.Protocol}" />
                                                    <TextBlock Style="{StaticResource Muted}" Text=" · " />
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedVpnKey.PingText}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding VpnStatusColor, Converter={StaticResource StringToBrush}}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding VpnStatusText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{Binding VpnStatusColor, Converter={StaticResource StringToBrush}}" />
                                            </StackPanel>

                                            <Button Command="{Binding VpnConnectCommand}" Margin="0,12,0,0"
                                                    HorizontalAlignment="Stretch" MinHeight="42"
                                                    ToolTip="Подключить или отключить VPN">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                        <Setter Property="Content" Value="Подключить VPN" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVpnRunning}" Value="True">
                                                                <Setter Property="Content" Value="Отключить VPN" />
                                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Тест скорости"
                                                        Command="{Binding SpeedTestCommand}"
                                                        ToolTip="Замер через текущее соединение: пинг, скачивание и отдача (Cloudflare)" />
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                           Text="{Binding SpeedTestText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="VPN по ключу" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Button Content="Обновить ядро" Style="{StaticResource LinkButton}"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding VpnInstallCoreCommand}" />
                                            </Grid>

                                            <TextBlock Text="Сайты через VPN" FontSize="12" FontWeight="SemiBold"
                                                       Margin="0,0,0,5" />
                                            <TextBox Text="{Binding VpnDomainsText}"
                                                     ToolTip="Сайты, которые пойдут через VPN: youtube.com, discord.com, openai.com" />

                                            <Expander Margin="0,8,0,0" IsExpanded="False"
                                                      HorizontalContentAlignment="Stretch"
                                                      Foreground="{StaticResource TextBrush}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Добавленные сайты" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding VpnSelectedSitesCount, StringFormat=' ({0})'}"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6"
                                                        Padding="6" Margin="0,4,0,0">
                                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding VpnSelectedSites}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,1,0,1">
                                                                        <Button DockPanel.Dock="Right" Content="×" Width="24" Height="22"
                                                                                Command="{Binding DataContext.RemoveVpnSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" />
                                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Expander>

                                            <ComboBox Margin="0,8,0,0" MinHeight="38" FontSize="13"
                                                      Style="{StaticResource SearchableCombo}"
                                                      ItemsSource="{Binding VpnTargetsView}"
                                                      SelectedItem="{Binding SelectedVpnTarget}"
                                                      Tag="{Binding VpnTargetSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DropDownOpened="VpnTargetsCombo_DropDownOpened"
                                                      DropDownClosed="VpnTargetsCombo_DropDownClosed"
                                                      ToolTip="Поиск по запущенным приложениям. Выбранное приложение добавляется в список ниже">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                                           Foreground="{StaticResource MutedBrush}" Margin="9,7,9,3" />
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,7,0,2"
                                                       Text="Выбранные приложения" />
                                            <ItemsControl ItemsSource="{Binding VpnSelectedPrograms}" Margin="0,3,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,1,0,1">
                                                            <Button DockPanel.Dock="Right" Content="×" Width="24" Height="22"
                                                                    Command="{Binding DataContext.RemoveVpnProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,4"
                                                       Text="Готовый список заблокированных сервисов РФ" />
                                            <ComboBox SelectedIndex="{Binding BlockedPresetIndex, Mode=TwoWay}" MinHeight="34">
                                                <ComboBoxItem Content="Не использовать" />
                                                <ComboBoxItem Content="Стандартный список (≈1,2 тыс. доменов)" />
                                                <ComboBoxItem Content="Полный реестр РКН (≈1,7 млн доменов)" />
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                       Text="{Binding BlockedListStatus}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource Muted}" Text="MTU туннеля:"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Text="{Binding VpnMtuText, UpdateSourceTrigger=LostFocus}"
                                                         Width="72" MinHeight="30"
                                                         ToolTip="1400 — для PPPoE, 1500 — для обычного Ethernet (допустимо 1280–9000)" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==================== 2. Обход DPI ==================== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,18,24,20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Обход DPI" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Движок zapret, цели обхода и стратегии. Игровой режим (серверы и порты игры) — в блоке ниже." />

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Border Background="#1A2FBF71" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                                            <TextBlock Text="{Binding DpiActiveText}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{Binding DpiActiveColor, Converter={StaticResource StringToBrush}}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Движок zapret" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiEngineStatus}" Margin="0,3,0,0" />
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiUpdateStatus}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Button Content="Обновить zapret" Command="{Binding DpiUpdateCommand}" Margin="0,0,6,0" />
                                            <Button Content="Проверить" Command="{Binding DpiCheckCommand}" Margin="0,0,6,0" />
                                            <Button Content="Стоп" Command="{Binding DpiStopCommand}" Margin="0,0,6,0" />
                                            <Button Content="Снять принудительно" Command="{Binding DpiForceStopCommand}"
                                                    ToolTip="Убить все процессы zapret и выгрузить драйвер WinDivert — если трафик всё ещё перехватывается" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox Content="Проверять обновления при запуске" Margin="0,0,18,0"
                                                  IsChecked="{Binding DpiCheckUpdates}" />
                                        <CheckBox Content="Обновлять автоматически" Margin="0,0,18,0"
                                                  IsChecked="{Binding DpiAutoUpdate}" />
                                        <CheckBox Content="Применять при подключении VPN"
                                                  IsChecked="{Binding DpiApplyOnConnect}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Что обходим" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding DpiTargetHosts, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Сайты для обхода DPI: discord.com, youtube.com" />
                                    <ComboBox Margin="0,6,0,0" MinHeight="38" FontSize="13"
                                              Style="{StaticResource SearchableCombo}"
                                              ItemsSource="{Binding DpiTargetsView}"
                                              SelectedItem="{Binding SelectedDpiTarget}"
                                              Tag="{Binding DpiTargetSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DropDownOpened="VpnTargetsCombo_DropDownOpened"
                                              DropDownClosed="DpiTargetsCombo_DropDownClosed"
                                              ToolTip="Поиск сайта или программы для обхода DPI" />
                                    <Expander Margin="0,8,0,0" IsExpanded="False"
                                              HorizontalContentAlignment="Stretch"
                                              Foreground="{StaticResource TextBrush}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Добавленные сайты" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding DpiSelectedTargetsCount, StringFormat=' ({0})'}"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6"
                                                Padding="6" Margin="0,4,0,0">
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding DpiSelectedTargets}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,1,0,1">
                                                                <Button DockPanel.Dock="Right" Content="×" Width="24" Height="22"
                                                                        Command="{Binding DataContext.RemoveDpiTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Expander>

                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,4"
                                               Text="Готовый список заблокированных сервисов РФ" />
                                    <ComboBox SelectedIndex="{Binding BlockedPresetIndex, Mode=TwoWay}" MinHeight="34">
                                        <ComboBoxItem Content="Не использовать" />
                                        <ComboBoxItem Content="Стандартный список (≈1,2 тыс. доменов)" />
                                        <ComboBoxItem Content="Полный реестр РКН (≈1,7 млн доменов)" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="{Binding BlockedPresetHint}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Text="{Binding BlockedListStatus}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                               Text="Проверяется TLS-рукопожатие с этими доменами — именно его ломает DPI. Оценка: скорость ответа (отлично ≤ 100 мс, хорошо ≤ 200 мс и т.д.)." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="8">
                                <DataGrid Height="240" ItemsSource="{Binding DpiStrategies}"
                                          SelectedItem="{Binding SelectedDpiStrategy}"
                                          IsReadOnly="True" EnableRowVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Стратегия" Binding="{Binding Name}" Width="*" MinWidth="220" />
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="80" />
                                        <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="150" />
                                        <DataGridTextColumn Header="Оценка" Binding="{Binding ScoreText}" Width="110" />
                                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Автоподбор лучшей" Style="{StaticResource AccentButton}"
                                            Command="{Binding DpiAutoSelectCommand}" Margin="0,0,8,0" />
                                    <Button Content="Применить" Command="{Binding DpiApplyCommand}" Margin="0,0,8,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding DpiProgressText}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                        <Run Text="Без обхода: " Foreground="#5A6478" />
                                        <Run Text="{Binding DpiBaselineText, Mode=OneWay}" />
                                        <Run Text="   Лучшая: " Foreground="#5A6478" />
                                        <Run Text="{Binding DpiBestText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Игровой режим: бывшая вкладка «Игры и сервисы», свёрнута по умолчанию -->
                            <Expander Margin="0,14,0,0" IsExpanded="False" Foreground="{StaticResource TextBrush}"
                                      HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Игровой режим: серверы и порты игры" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="обход по IP и портам, отдельно от сайтов" />
                                    </StackPanel>
                                </Expander.Header>
                                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Muted}"
                                                   Text="Запустите игру и войдите на сервер. ExitBoost отслеживает системные события соединений: TCP-таблицу и UDP FLOW (только IP, порты и PID процесса — без чтения трафика)." />

                                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Процесс игры" />
                                        <ComboBox Margin="0,4,0,0" MinHeight="34" MaxDropDownHeight="260"
                                                  ItemsSource="{Binding Processes}"
                                                  SelectedValuePath="Name"
                                                  SelectedValue="{Binding DpiGameProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsTextSearchEnabled="True"
                                                  ToolTip="Выберите запущенную игру — по её соединениям будут найдены серверы">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                   Text="IP серверов игры (по одному в строке)" />
                                        <TextBox Margin="0,4,0,0" MinHeight="72" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding DpiGameIps, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="IP-адреса серверов игры, по одному в строке" />

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Style="{StaticResource Muted}" Text="TCP-порты игры" />
                                                <TextBox Margin="0,4,0,0"
                                                         Text="{Binding DpiGameTcpPorts, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="TCP-порты игры: 6112 или 6112,27015-27020" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Style="{StaticResource Muted}" Text="UDP-порты игры" />
                                                <TextBox Margin="0,4,0,0"
                                                         Text="{Binding DpiGameUdpPorts, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="UDP-порты игры (голос, бой): 3074 или 3478-3480" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Серверы игры" VerticalAlignment="Bottom"
                                                    Command="{Binding DpiDetectGameCommand}"
                                                    ToolTip="Взять IP-адреса и TCP-порты из соединений выбранной игры" />
                                        </Grid>

                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="{Binding DpiGameSummary}" />

                                        <DataGrid Height="200" Margin="0,10,0,0"
                                                  ItemsSource="{Binding DpiGameStrategiesView}"
                                                  SelectedItem="{Binding SelectedDpiStrategy}"
                                                  IsReadOnly="True" EnableRowVirtualization="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Стратегия" Binding="{Binding Name}" Width="*" MinWidth="200" />
                                                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="150" />
                                                <DataGridTextColumn Header="Оценка" Binding="{Binding ScoreText}" Width="110" />
                                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="130" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                                   Text="Если ни одна стратегия не помогла, блокировка идёт по IP — тогда добавьте игру в «Выбранные приложения» на странице «Локации», чтобы её трафик шёл через VPN." />
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== 3. Журнал ==================== -->
                <TabItem>
                    <Grid Margin="24,18,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Журнал" VerticalAlignment="Center" />
                            <Button Content="Скопировать" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                    Command="{Binding CopyLogCommand}" />
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                            <Grid>
                                <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap">
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="#5A6478" />
                                                <Run Text=" " Foreground="#5A6478" />
                                                <Run Text="{Binding LevelText, Mode=OneWay}" Foreground="#7C87A0" />
                                                <Run Text="  " Foreground="#5A6478" />
                                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="#DCE2EC" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Пока нет записей. Действия приложения — подключение, обход DPI, обновления — появятся здесь."
                                           TextWrapping="Wrap" MaxWidth="420"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== 4. Настройки ==================== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,18,24,20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Настройки" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Режим подключения, общие параметры, обновления и сеть." />

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Режим подключения" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <RadioButton GroupName="VpnModeSettings" Margin="0,0,0,8"
                                                 IsChecked="{Binding VpnModeIsSplit, Mode=TwoWay}">
                                        <TextBlock Text="Только выбранные сайты и программы" TextWrapping="Wrap" />
                                    </RadioButton>
                                    <RadioButton GroupName="VpnModeSettings"
                                                 IsChecked="{Binding VpnModeIsFull, Mode=TwoWay}">
                                        <TextBlock Text="Весь трафик через VPN" TextWrapping="Wrap" />
                                    </RadioButton>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="В режиме сплита VPN трогает только выбранные сайты и программы — остальная сеть работает напрямую. Режим применяется при следующем подключении." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Общие" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" Text="При нажатии на крестик:" />
                                        <ComboBox Width="280" SelectedIndex="{Binding CloseActionIndex}"
                                                  ToolTip="Что делать при закрытии окна: свернуть в значок трея или отключиться и выйти">
                                            <ComboBoxItem Content="Свернуть в трей (работа продолжится)" />
                                            <ComboBoxItem Content="Отключиться и выйти" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                               Text="При выходе программа сама отключит соединение, остановит обход DPI (вместе с драйвером) и снимет оставшиеся туннели, чтобы не оставить сеть в нерабочем состоянии." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Списки и подписки" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <CheckBox Content="Автоматически обновлять списки РКН (раз в неделю)"
                                              IsChecked="{Binding ListsAutoUpdate}" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="23,0,0,8"
                                               Text="{Binding ListsUpdatedText}" />
                                    <CheckBox Content="Автоматически обновлять ключи по ссылкам-подпискам"
                                              IsChecked="{Binding AutoUpdateSubscriptions}" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="23,0,0,10"
                                               Text="{Binding SubscriptionsStatusText}" />
                                    <WrapPanel>
                                        <Button Content="Обновить списки" Command="{Binding RefreshListsCommand}"
                                                Margin="0,0,8,0"
                                                ToolTip="Скачать свежую копию выбранного списка РКН" />
                                        <Button Content="Обновить подписки" Command="{Binding RefreshSubscriptionsCommand}"
                                                ToolTip="Перечитать ключи по сохранённым ссылкам-подпискам" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Обновления" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="Обновления скачиваются только с официального репозитория и проверяются по SHA-256">
                                            <Run Text="Источник: " />
                                            <Run Text="{Binding UpdateSourceText, Mode=OneWay}"
                                                 Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <Run Text=" (официальный)" />
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="Проверить обновления" Margin="8,0,0,0"
                                                Command="{Binding UpdateCheckCommand}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Content="Проверять при запуске" IsChecked="{Binding CheckAppUpdatesOnStart}"
                                                  Margin="0,0,16,0" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="{Binding CurrentVersionText}" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="  ·  " />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="{Binding UpdateStatusText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,6,0,0"
                                               Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Установить обновление" Style="{StaticResource AccentButton}"
                                                Command="{Binding UpdateInstallCommand}" Margin="0,0,6,4" />
                                        <Button Content="Отменить загрузку" Style="{StaticResource LinkButton}"
                                                Command="{Binding UpdateCancelCommand}" Margin="0,0,6,4"
                                                Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Страница релиза" Style="{StaticResource LinkButton}"
                                                Command="{Binding UpdateOpenPageCommand}" Margin="0,0,6,4" />
                                    </WrapPanel>
                                    <Border Background="#1AFFFFFF" CornerRadius="7" Padding="10" Margin="0,8,0,0"
                                            Visibility="{Binding HasUpdateNotes, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" FontWeight="SemiBold" Text="Что нового" />
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding UpdateNotesText}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding HasUpdateResult, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Text="{Binding UpdateResultText}" />
                                        <Button Content="Журнал обновления" Style="{StaticResource LinkButton}"
                                                Command="{Binding UpdateOpenLogCommand}" Margin="8,0,0,0"
                                                Visibility="{Binding HasUpdateLog, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="VPN и сеть" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Style="{StaticResource Muted}" Text="Игра для автообхода VPN" Margin="0,0,0,4" />
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshProcessesCommand}"
                                                Margin="8,0,0,0" ToolTip="Обновить список запущенных процессов" />
                                        <ComboBox ItemsSource="{Binding Processes}" SelectedValuePath="Name"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding VpnGameProcess, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Выбор для VPN автообхода; не влияет на zapret/DPI" />
                                    </DockPanel>
                                    <CheckBox Content="Автообход недоступных игровых серверов через VPN (TCP и UDP)"
                                              IsChecked="{Binding AutoGameVpnFallback}" Margin="0,0,0,5"
                                              ToolTip="TCP: попытка зависла в SYN_SENT 8 с, нет ответных данных 8 с или сервер дважды сбросил соединение. UDP: игра повторно отправляет пакеты без ответов. Маршрут добавляется только для выбранной игры и IP сервера." />
                                    <CheckBox Content="Вся игра через VPN (стабильнее, но пинг как у выбранной локации)"
                                              IsChecked="{Binding RouteGameThroughVpn}" Margin="0,0,0,5"
                                              ToolTip="Одно правило по процессу: весь трафик выбранной игры уходит через VPN, остальные программы — напрямую. Применяется сразу, игра переподключится." />
                                    <TextBlock Style="{StaticResource Muted}" Margin="22,0,0,8" TextWrapping="Wrap"
                                               Text="Выбор игры независим от обхода DPI. Блокировка определяется по сетевому обмену, это эвристика; остальные адреса остаются напрямую. После смены маршрута игре может потребоваться переподключиться." />
                                    <TextBlock Text="{Binding GameVpnStatusText}" Margin="0,0,0,3" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GameVpnMonitorStatusText}" Style="{StaticResource Muted}"
                                               Margin="0,0,0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding GameVpnTrafficText}" Style="{StaticResource Muted}"
                                               Margin="0,0,0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding GameVpnServerStatusText}" Style="{StaticResource Muted}"
                                               Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <Button Content="{Binding GameVpnSuspectText}" Command="{Binding GameVpnApplyCommand}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10"
                                            IsEnabled="{Binding HasGameVpnSuspect}"
                                            ToolTip="Добавляет точечное правило только для этого IP игры. Ядро перезапустится, игра переподключится." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                                   Text="Ядро sing-box: ключи, MTU и готовые списки настраиваются на странице «Локации»." />
                                        <Button Grid.Column="1" Content="Обновить ядро" Margin="8,0,0,0"
                                                Command="{Binding VpnInstallCoreCommand}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Починить интернет" Command="{Binding RestoreNetworkCommand}"
                                                ToolTip="Снять туннель, вернуть маршруты, очистить DNS-кэш и проверить доступ в сеть" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Text="{Binding InterfaceText, StringFormat='Интерфейс: {0}'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Статус-бар -->
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="24,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Run Text="Интерфейс: " />
                        <Run Text="{Binding InterfaceText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center">
                        <Run Text="Время: " />
                        <Run Text="{Binding ElapsedText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
