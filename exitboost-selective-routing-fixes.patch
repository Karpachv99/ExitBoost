diff --git a/tests/ExitBoost.Tests/CidrMathTests.cs b/tests/ExitBoost.Tests/CidrMathTests.cs
--- a/tests/ExitBoost.Tests/CidrMathTests.cs
+++ b/tests/ExitBoost.Tests/CidrMathTests.cs
@@ -43,6 +43,21 @@
     public void Разбор_одиночного_адреса()
     {
         Assert.True(CidrMath.TryParse("192.0.2.5", out var start, out var end));
         Assert.Equal(start, end);
     }
+
+    [Theory]
+    [InlineData("192.0.2.1/not-a-prefix")]
+    [InlineData("192.0.2.1/")]
+    [InlineData("192.0.2.1/33")]
+    [InlineData("192.0.2.1/-1")]
+    [InlineData("192.0.2.1/24/extra")]
+    [InlineData("")]
+    public void Некорректный_CIDR_возвращает_false_без_исключения(string cidr)
+    {
+        var exception = Record.Exception(() => CidrMath.TryParse(cidr, out _, out _));
+
+        Assert.Null(exception);
+        Assert.False(CidrMath.TryParse(cidr, out _, out _));
+    }
 }
diff --git a/tests/ExitBoost.Tests/TunnelOptionsTests.cs b/tests/ExitBoost.Tests/TunnelOptionsTests.cs
--- a/tests/ExitBoost.Tests/TunnelOptionsTests.cs
+++ b/tests/ExitBoost.Tests/TunnelOptionsTests.cs
@@ -15,6 +15,42 @@
     public void FullTunnel_RemainsExplicitWhenRouteListIsEmpty()
     {
         var options = new TunnelOptions { Mode = RoutingMode.FullTunnel };

         Assert.Equal("0.0.0.0/0", options.AllowedIpsString);
     }
+
+    [Fact]
+    public void SyncConf_Omits_AllowedIPs_When_ProcessSplit_Has_No_Routes()
+    {
+        var node = new NodeConfig
+        {
+            PrivateKey = "private-key",
+            PublicKey = "public-key",
+            Host = "203.0.113.10",
+            Port = 51820
+        };
+        var options = new TunnelOptions { Mode = RoutingMode.ProcessSplit };
+
+        var config = WireGuardConfigBuilder.BuildSyncConf(node, options);
+
+        Assert.DoesNotContain("AllowedIPs =", config);
+        Assert.DoesNotContain("AllowedIPs = 0.0.0.0/0", config);
+    }
+
+    [Fact]
+    public void SyncConf_Keeps_Explicit_FullTunnel_Route()
+    {
+        var node = new NodeConfig
+        {
+            PrivateKey = "private-key",
+            PublicKey = "public-key",
+            Host = "203.0.113.10",
+            Port = 51820
+        };
+        var options = new TunnelOptions { Mode = RoutingMode.FullTunnel };
+
+        var config = WireGuardConfigBuilder.BuildSyncConf(node, options);
+
+        Assert.Contains("AllowedIPs = 0.0.0.0/0", config);
+    }
 }
