diff --git a/src/ExitBoost.Core/Networking/CidrMath.cs b/src/ExitBoost.Core/Networking/CidrMath.cs
--- a/src/ExitBoost.Core/Networking/CidrMath.cs
+++ b/src/ExitBoost.Core/Networking/CidrMath.cs
@@ -48,10 +48,14 @@
         if (string.IsNullOrWhiteSpace(cidr)) return false;

         string[] parts = cidr.Split('/');
+        // Reject malformed CIDR strings instead of throwing from int.Parse.
+        // A second slash is never valid IPv4 CIDR notation.
+        if (parts.Length > 2) return false;
         if (!IPAddress.TryParse(parts[0].Trim(), out var ip)) return false;
         if (ip.AddressFamily != AddressFamily.InterNetwork) return false;

         uint value = ToUInt(ip);
-        int prefix = parts.Length > 1 ? int.Parse(parts[1]) : 32;
+        int prefix = 32;
+        if (parts.Length == 2 && !int.TryParse(parts[1].Trim(), out prefix)) return false;
         if (prefix < 0 || prefix > 32) return false;

